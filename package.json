{
  "name": "outpost",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Your Claude Code sessions, as chats: one page to read, drive and start them from, on any device.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Danny Ramos",
  "keywords": [
    "claude-code",
    "coding-agent",
    "developer-tools",
    "chat",
    "dashboard"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && node server/serve.mjs",
    "serve": "node server/serve.mjs",
    "hooks": "node tools/install-hooks.mjs",
    "passwd": "node tools/set-password.mjs",
    "retry:log": "node tools/retry-log.mjs",
    "tokens:report": "node tools/token-report.mjs",
    "typecheck": "tsc --noEmit",
    "check:names": "node scripts/check-names.mjs",
    "test": "node --test --test-reporter=spec --experimental-test-module-mocks 'test/*.test.mjs'",
    "check": "yarn typecheck && yarn check:names --strict && yarn test && yarn build"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@mdi/js": "^7.4.47",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2",
    "vite": "^7.1.0"
  },
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e"
}
