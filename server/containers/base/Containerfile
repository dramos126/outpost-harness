# Outpost's base image for a chat's container (docs/proposals/containers.md).
#
# What every chat needs and the stock image lacks: git (a chat commits in its checkout; the
# memory key is the mirror's path), curl (the SessionStart hook is a curl), and python3, make
# and g++ — a native Node module with no prebuilt binary for this Node compiles on install
# (one repo's better-sqlite3 did, and its first chat in a container failed without them;
# its own Dockerfile installs the same three). Node and npm,
# with corepack for yarn, come with the base. The claude program is not in here: it is mounted
# read-only from the host at /usr/local/bin/claude, so a container runs the same CLI as every
# other chat and an update is one install, not a rebuild per repo.
#
# Chromium's system libraries, the ones Playwright's `install-deps chromium` names for bookworm,
# plus a font: a chat that drives a headless browser (screenshots, end-to-end tests) otherwise
# fails launching it with a missing libnss3 or libgbm, and cannot apt-get them itself without
# root. The browser itself is not here; Playwright or Puppeteer downloads its own into ~/.cache.
#
# Built once per machine and tagged by this file's content, so a change here is a new image
# and the old one is left for `podman image prune`.
FROM docker.io/library/node:22-bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends git curl ca-certificates python3 make g++ \
    libasound2 libatk-bridge2.0-0 libatk1.0-0 libatspi2.0-0 libcairo2 libcups2 libdbus-1-3 \
    libdrm2 libgbm1 libglib2.0-0 libnspr4 libnss3 libpango-1.0-0 libx11-6 libxcb1 \
    libxcomposite1 libxdamage1 libxext6 libxfixes3 libxkbcommon0 libxrandr2 fonts-liberation \
 && rm -rf /var/lib/apt/lists/*
