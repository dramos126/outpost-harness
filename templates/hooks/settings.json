{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sS --max-time 3 -X POST -H 'Content-Type: application/json' --data-binary @- http://127.0.0.1:5274/api/hook >/dev/null 2>&1 || true",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "http", "url": "http://127.0.0.1:5274/api/hook", "async": true, "timeout": 5 }] }
    ],
    "PreToolUse": [
      { "hooks": [{ "type": "http", "url": "http://127.0.0.1:5274/api/hook", "async": true, "timeout": 5 }] }
    ],
    "PostToolBatch": [
      { "hooks": [{ "type": "http", "url": "http://127.0.0.1:5274/api/hook", "async": true, "timeout": 5 }] }
    ],
    "PostToolUseFailure": [
      { "hooks": [{ "type": "http", "url": "http://127.0.0.1:5274/api/hook", "async": true, "timeout": 5 }] }
    ],
    "Notification": [
      { "hooks": [{ "type": "http", "url": "http://127.0.0.1:5274/api/hook", "async": true, "timeout": 5 }] }
    ],
    "SubagentStart": [
      { "hooks": [{ "type": "http", "url": "http://127.0.0.1:5274/api/hook", "async": true, "timeout": 5 }] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "http", "url": "http://127.0.0.1:5274/api/hook", "async": true, "timeout": 5 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "http", "url": "http://127.0.0.1:5274/api/hook", "async": true, "timeout": 5 }] }
    ],
    "StopFailure": [
      { "hooks": [{ "type": "http", "url": "http://127.0.0.1:5274/api/hook", "async": true, "timeout": 5 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "http", "url": "http://127.0.0.1:5274/api/hook", "async": true, "timeout": 5 }] }
    ]
  }
}
